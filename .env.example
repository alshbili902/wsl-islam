# Wasl Islamic (وصل الإسلامية) — Environment Variables
# Copy this file to .env.local and fill in your credentials where applicable.
# Note: The platform works out-of-the-box with verified public Islamic APIs
# (Al-Quran Cloud, MP3Quran, AlAdhan, jsDelivr Hadith CDN) and bundled verified datasets.
# Supabase credentials are optional and enable persistent database-backed content delivery.

# Public Site URL (used for SEO canonical URLs, Open Graph, sitemap, and Share Card QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Supabase Configuration (Client & Server Read-Only Public Content)
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser or client components.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Server-Only Supabase Service Role Key (for server-side seeding or privileged sync tasks only)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Web Push Notification Credentials (VAPID)
# Generate using: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@wasl-islamic.org
# Bearer token required by POST /api/push/cron for scheduled Web Push dispatch
PUSH_CRON_SECRET=
